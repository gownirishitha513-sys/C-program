#include <stdio.h>
struct Employee
{
int empId;
char name[50];
float salary;
};
int main()
{
int n, i, max;
printf("Enter number of employees: ");
scanf("%d", &n);
struct Employee e[n];
for(i = 0; i < n; i++)
{
printf("\nEmployee %d\n", i + 1);
printf("Enter Employee ID: ");
scanf("%d", &e[i].empId);
printf("Enter Employee Name: ");
scanf("%s", e[i].name);
printf("Enter Salary: ");
scanf("%f", &e[i].salary);
}
max = 0;
for(i = 1; i < n; i++){
if(e[i].salary > e[max].salary)
{
max = i;
}
}
printf("\nEmployee with Highest Salary\n");
printf("Employee ID   : %d\n", e[max].empId);
printf("Employee Name : %s\n", e[max].name);
printf("Salary        : %.2f\n", e[max].salary);
return 0;
}